{
  "name": "dsh-flipper",
  "version": "0.3.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "description": "让 AI 和桌面 DSH 一起遥控 Flipper Zero：屏幕镜像、方向键、App、SD 卡、Sub-GHz/NFC/RFID/红外/BadUSB。电脑端直接调 Win32 串口，不需要手动跑 python 桥。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazling/dsh-flipper.git"
  },
  "homepage": "https://github.com/nazling/dsh-flipper#readme",
  "bugs": {
    "url": "https://github.com/nazling/dsh-flipper/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "flipper",
    "flipper-zero",
    "rpc",
    "ble",
    "android",
    "bluetooth",
    "serial",
    "desktop"
  ],
  "license": "MIT",
  "files": [
    "index.js",
    "lib",
    "tools",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "install.sh",
    "install.ps1"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "Flipper",
      "en": "Flipper"
    },
    "icon": "robot",
    "wants": [],
    "contributes": {
      "composer.strip": [
        {
          "id": "flipper-status",
          "icon": "bolt",
          "panel": "flipper"
        }
      ],
      "panels": [
        {
          "id": "flipper",
          "title": "Flipper 状态",
          "icon": "robot",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  },
  "scripts": {
    "test": "node test/e2e.mjs && node test/api-e2e.mjs",
    "prepublishOnly": "node test/e2e.mjs && node test/api-e2e.mjs"
  }
}
