<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Flipper BLE 桥"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="蓝牙串口 → 本地 TCP"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="未运行"
            android:textColor="@color/primaryDark"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:text="提示：以前配对过 Flipper 的话，请先在系统蓝牙里取消配对，并把蓝牙关开一次，再回来扫描。Android 会复用旧的 GATT 缓存，容易出现连接异常。"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/scan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary"
        android:text="扫描并连接 Flipper"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCP 端口"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/port"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:inputType="number"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="9757"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/stop"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_danger"
            android:minWidth="72dp"
            android:text="停止"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/reconnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_secondary"
        android:text="重新连接 Flipper"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <Button
        android:id="@+id/unpair"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_secondary"
        android:text="取消配对 / 打开蓝牙设置"
        android:textAllCaps="false"
        android:textColor="@color/danger"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="运行日志"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/btn_secondary"
            android:minWidth="60dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="清空"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_log"
        android:fillViewport="true">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/logText"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
